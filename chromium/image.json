{
  "description": "Headless Chromium browser with a Chrome DevTools Protocol listener.",
  "version_source": "deb-package",
  "version_ref": "chromium",
  "tag_suffix": "-cdp",
  "latest": "latest-cdp",
  "builder": "native",
  "watch": ["scripts/image_tags.py", "chromium/**"],
  "ignore": ["chromium/**/*.md", "chromium/**/docs/**", "chromium/**/compose*.yaml", "chromium/**/compose*.yml", "chromium/**/docker-compose*.yaml", "chromium/**/docker-compose*.yml"]
}

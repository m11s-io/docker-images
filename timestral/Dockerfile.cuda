# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

ARG TIMESTRAL_VERSION=1.0.0
ARG PYTHON_BASE=python:3.15.2-slim-bookworm@sha256:4d54a654d391909a6c0de8035e15c01ad196d31e4a1552bb328bf1181e4d393a

FROM ${PYTHON_BASE} AS build
ARG PYTHON_BASE
ARG TIMESTRAL_VERSION
ENV UV_CACHE_DIR=/tmp/uv-cache \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.13.6
COPY pyproject.toml uv.lock ./
COPY check_version.py ./
RUN uv sync --frozen --no-dev --no-install-package torch \
    && uv pip install --python /opt/venv/bin/python \
         --index-url https://download.pytorch.org/whl/cu126 torch==2.14.1+cu126 \
    && /opt/venv/bin/python check_version.py "$TIMESTRAL_VERSION" \
    && rm -rf /tmp/uv-cache

# The CUDA PyTorch wheel installs its CUDA userspace libraries. Keep CPython
# and its shared libraries on the same Debian base as the build stage.
FROM ${PYTHON_BASE} AS runtime
ARG TIMESTRAL_VERSION
LABEL org.opencontainers.image.title="Timestral API (CUDA 12.6)" \
      org.opencontainers.image.version=${TIMESTRAL_VERSION} \
      org.opencontainers.image.source="https://github.com/m11s-io/docker-images"
ENV PATH=/opt/venv/bin:/usr/local/bin:${PATH} \
    MODEL_DEVICE=cuda \
    HF_HOME=/models/huggingface \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY app ./app
RUN addgroup --system --gid 10001 timestral \
    && adduser --system --uid 10001 --ingroup timestral --home /nonexistent timestral \
    && mkdir -p /models /tmp \
    && chown -R 10001:10001 /models /tmp
USER 10001:10001
EXPOSE 8000
VOLUME ["/models"]
ENTRYPOINT ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

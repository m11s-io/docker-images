# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

ARG TIMESTRAL_VERSION=0.1.0
ARG PYTHON_BASE=python:3.15.2-slim-bookworm@sha256:4d54a654d391909a6c0de8035e15c01ad196d31e4a1552bb328bf1181e4d393a
ARG CUDA_BASE=nvidia/cuda:12.6.3-runtime-ubuntu24.04@sha256:92906d87596d638d35015c6353053121bd299d25943b875763321653884ba924

FROM ${PYTHON_BASE} AS build
ENV UV_CACHE_DIR=/tmp/uv-cache \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.8.22
COPY pyproject.toml uv.lock ./
COPY app ./app
RUN uv sync --frozen --no-dev --no-install-package torch \
    && uv pip install --python /opt/venv/bin/python \
         --index-url https://download.pytorch.org/whl/cu126 torch==2.13.0 \
    && rm -rf /tmp/uv-cache

FROM ${PYTHON_BASE} AS python-runtime

FROM ${CUDA_BASE} AS runtime
ARG TIMESTRAL_VERSION
LABEL org.opencontainers.image.title="Timestral API (CUDA 12.6)" \
      org.opencontainers.image.version=${TIMESTRAL_VERSION} \
      org.opencontainers.image.source="https://github.com/m11s-io/docker-images"
ENV PATH=/opt/venv/bin:/usr/local/bin:${PATH} \
    MODEL_DEVICE=cuda \
    HF_HOME=/models/huggingface \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /app
COPY --from=python-runtime /usr/local /usr/local
COPY --from=build /opt/venv /opt/venv
COPY app ./app
RUN addgroup --system --gid 10001 timestral \
    && adduser --system --uid 10001 --ingroup timestral --home /nonexistent timestral \
    && mkdir -p /models /tmp \
    && chown -R 10001:10001 /models /tmp
USER 10001:10001
EXPOSE 8000
VOLUME ["/models"]
ENTRYPOINT ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
ARG TIMESTRAL_VERSION=1.0.0
ARG PYTHON_BASE=python:3.13.18-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f

FROM ${PYTHON_BASE} AS build
ARG TIMESTRAL_VERSION
ENV UV_CACHE_DIR=/tmp/uv-cache UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.13.6
COPY dependencies/cpu/pyproject.toml dependencies/cpu/uv.lock ./
COPY check_version.py ./
RUN uv sync --frozen --no-dev \
    && /opt/venv/bin/python check_version.py "$TIMESTRAL_VERSION" \
    && rm -rf /tmp/uv-cache

FROM ${PYTHON_BASE} AS runtime
ARG TIMESTRAL_VERSION
LABEL org.opencontainers.image.title="Timestral standard V2 (cpu)" \
      org.opencontainers.image.version=${TIMESTRAL_VERSION} \
      org.opencontainers.image.source="https://github.com/m11s-io/docker-images" \
      io.m11s.timestral.contract="1"
ENV PATH=/opt/venv/bin:${PATH} \
    MODEL_DEVICE=cpu TIMESTRAL_BACKEND=cpu \
    HF_HOME=/models/huggingface TORCH_NUM_THREADS=2 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY serving/ ./serving/
RUN addgroup --system --gid 10001 timestral \
    && adduser --system --uid 10001 --ingroup timestral --home /nonexistent timestral \
    && mkdir -p /models \
    && chown 10001:10001 /models \
    && printf '%s\n' 'cpu' > /app/image-variant
USER 10001:10001
EXPOSE 8080 8081
VOLUME ["/models"]
ENTRYPOINT ["python", "-m", "serving"]
CMD ["--workers", "1", "--http_port", "8080", "--grpc_port", "8081", "--grpc_max_receive_message_length", "8388608"]

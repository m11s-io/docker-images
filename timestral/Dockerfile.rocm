# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

ARG TIMESTRAL_VERSION=1.0.0
ARG ROCM_BASE=rocm/pytorch:rocm10.1.0_ubuntu26.04_py3.14_pytorch_release_2.14.0@sha256:68295d40dcdcb53d9b50828f30017faad8cf5ad9a8c7923c5a815b414b45e3e6
FROM ${ROCM_BASE} AS runtime
ARG TIMESTRAL_VERSION
USER root
WORKDIR /app
# Keep AMD's validated PyTorch and its matching ROCm libraries intact.
COPY requirements-rocm.txt requirements-torch-rocm.txt check_version.py ./
ENV PIP_CONSTRAINT=/app/requirements-torch-rocm.txt
RUN python3 -m pip install --no-cache-dir --require-hashes --no-deps -r requirements-rocm.txt \
    && python3 -m pip install --no-cache-dir --no-deps 'timestral @ git+https://github.com/mistralai/timestral.git@a534bdbd244d64f3d9d743f46c7bf6fc330ed4ff' \
    && python3 -m pip check \
    && python3 check_version.py "$TIMESTRAL_VERSION" rocm

LABEL org.opencontainers.image.title="Timestral API (ROCm)" \
      org.opencontainers.image.version=${TIMESTRAL_VERSION} \
      org.opencontainers.image.source="https://github.com/m11s-io/docker-images"
ENV MODEL_DEVICE=cuda \
    HF_HOME=/models/huggingface \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY app ./app
RUN mkdir -p /models /tmp && chown 10001:10001 /models
USER 10001:10001
EXPOSE 8000
VOLUME ["/models"]
ENTRYPOINT ["python3", "-m", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

# Validate the shared API on this Python/PyTorch stack before exporting an image.
FROM runtime AS validation
USER root
COPY requirements-rocm-test.txt ./
# Freeze the complete shipped environment before adding test-only dependencies.
# Constraints prevent even transitive upgrades from hiding a runtime mismatch.
RUN python3 -m pip freeze > /tmp/runtime-constraints.txt && \
    python3 -m venv --system-site-packages /opt/test-venv && \
    /opt/test-venv/bin/python -m pip install --no-cache-dir \
        --constraint /tmp/runtime-constraints.txt --require-hashes --no-deps \
        -r requirements-rocm-test.txt && \
    /opt/test-venv/bin/python -m pip check
COPY tests ./tests
USER 10001:10001
RUN /opt/test-venv/bin/python -m pytest tests/test_api.py -q -p no:cacheprovider \
    && touch /tmp/timestral-api-validated

FROM runtime AS final
COPY --from=validation /tmp/timestral-api-validated /usr/local/share/timestral-api-validated

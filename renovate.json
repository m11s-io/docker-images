{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>m11s-io/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Auto-merge Docker digest updates after checks pass",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "rebaseWhen": "behind-base-branch",
      "ignoreTests": false
    },
    {
      "description": "Group ComfyUI application, base image, and PyTorch version updates",
      "matchFileNames": [
        "comfyui/Dockerfile",
        "comfyui/requirements-cuda.txt"
      ],
      "groupName": "ComfyUI Dockerfile dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "rebaseWhen": "behind-base-branch",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Keep ComfyUI on its validated Python 3.14 runtime",
      "matchPackageNames": [
        "python"
      ],
      "matchFileNames": [
        "comfyui/**"
      ],
      "allowedVersions": "/^3\\.14\\./"
    },
    {
      "description": "Discover stable CUDA variants from the aggregate official PyTorch index",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "torch",
        "torchvision"
      ],
      "matchFileNames": [
        "comfyui/requirements-cuda.txt",
        "timestral/requirements-cuda.txt"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+\\+cu\\d+$/",
      "minimumReleaseAge": "0 days",
      "ignoreUnstable": true
    },
    {
      "description": "Update and auto-merge Timestral CPU and CUDA PyTorch releases together after checks pass",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "torch"
      ],
      "matchFileNames": [
        "timestral/**"
      ],
      "groupName": "Timestral PyTorch",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "rebaseWhen": "behind-base-branch",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Keep Timestral's default PyTorch distribution CPU-only",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "torch"
      ],
      "matchFileNames": [
        "timestral/pyproject.toml"
      ],
      "allowedVersions": "/\\+cpu$/",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Allow a longer release interval for the maintained Docker Hub description action",
      "matchDatasources": [
        "github-actions"
      ],
      "matchPackageNames": [
        "peter-evans/dockerhub-description"
      ],
      "abandonmentThreshold": "2 years"
    },
    {
      "description": "Keep Timestral on its validated Python 3.15 runtime",
      "matchPackageNames": [
        "python"
      ],
      "matchFileNames": [
        "timestral/**"
      ],
      "allowedVersions": "/^3\\.15\\./"
    }
  ],
  "digest": {
    "branchTopic": "{{{depNameSanitized}}}-digest"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track application and plugin versions declared in Dockerfile arguments",
      "managerFilePatterns": [
        "/^(caddy-cloudflare|s3-upload-proxy|comfyui|comfy-mcp)\\/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the DeepSeek release and its source commit together",
      "managerFilePatterns": [
        "/^deepseek-harness\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DSH_REF=(?<currentValue>dsh-v\\S+)\\s+ARG DSH_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "deepseek-ai/deepseek-harness",
      "extractVersionTemplate": "^dsh-v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}

# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
#
# Optional ComfyUI-GGUF extension for m11s/comfyui. Keep the generic image
# free of community nodes; this variant has the same ComfyUI/CUDA release.

# CI overrides this default when it rebuilds the generic image.
ARG COMFYUI_BASE=m11s/comfyui:0.43.0@sha256:7b9b2af16f4e7916678b929d2de0a3492eddcd95376b07bcbfc759a2f3162910
FROM ${COMFYUI_BASE} AS runtime

ARG COMFYUI_GGUF_REF=6ea2651e7df66d7585f6ffee804b20e92fb38b8a

USER root

RUN git init custom_nodes/ComfyUI-GGUF && \
    git -C custom_nodes/ComfyUI-GGUF remote add origin https://github.com/city96/ComfyUI-GGUF.git && \
    git -C custom_nodes/ComfyUI-GGUF fetch --depth 1 origin ${COMFYUI_GGUF_REF} && \
    git -C custom_nodes/ComfyUI-GGUF checkout --detach FETCH_HEAD && \
    python -m pip install --no-cache-dir --only-binary=comfy-kitchen,comfy-aimdo \
        -r custom_nodes/ComfyUI-GGUF/requirements.txt && \
    chown -R comfyui:comfyui custom_nodes/ComfyUI-GGUF

USER comfyui

FROM runtime AS validation
COPY verify_image.py /app/verify_image.py
RUN python /app/verify_image.py --gguf && touch /tmp/comfyui-validated

# Depend on validation without including its generated startup state.
FROM runtime AS final
COPY --from=validation /tmp/comfyui-validated /usr/local/share/comfyui/image-validated

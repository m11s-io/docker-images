.git
.gitignore
**/.next
**/node_modules
**/.turbo
**/dist
**/build
**/*.log
.env
.env.*
!.env.example
README.md

# Keep the prebuilt Next.js runtime, including its bundled node_modules.
!apps/web/.next/
apps/web/.next/*
!apps/web/.next/standalone/
!apps/web/.next/standalone/**
!apps/web/.next/static/
!apps/web/.next/static/**
